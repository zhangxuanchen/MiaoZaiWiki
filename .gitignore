# ─────────────────────────────────────────────
# 喵藏 · .gitignore
# ─────────────────────────────────────────────
# 原则：仓库只放源码 + 文档 + 素材。
# 所有"本地生成 / 可再构建 / 个人环境"的东西一律不进 git。
#
# ⚠️ 注意：gitignore 里**只有行首的 # 才是注释**。
# 行尾的 "# 注释" 会被当成模式的一部分，导致整条规则失效。
# 所以下面所有注释都独立成行，规则行保持干净。

# ── Python ────────────────────────────────────
# 虚拟环境（几十 MB，各自机器上本地生成）
dist/miao-zang/scripts/.venv/
**/venv/
.venv/
# 字节码缓存
__pycache__/
*.pyc
*.pyo

# ── macOS ────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ── 开发快照 / 暂存 ───────────────────────────
# 源码快照（每次改 main.swift 前留的副本，约 10 MB）。
# git 本身就是版本控制，这份是冗余的；想用 .snapshots 快速回滚就删掉下面这行。
.snapshots/
# 截图暂存（空目录）
_shots/

# ── 打包产物（可分发的 app / dmg / 引擎）──────
# 内嵌引擎（几十 MB，本地构建；跑 make_engine.sh 重建）
dist/.engine/
# 组装 .app 的临时目录
dist/.stage/
# 打 DMG 的临时目录
dist/.dmgstage/
# 出货目录（.dmg 体积大，要发版时手动上传）
dist/release/
# 引擎 / 版权材料的可分发压缩包（内容与目录重复）
dist/*.zip

# ── 版权登记材料的压缩包 ──────────────────────
# 它是从「猫崽角色设计_版权材料/」整目录打出来的，内容完全重复，
# 要用的时候重新打一次即可，不必进仓库。
猫崽角色设计_版权登记材料_*.zip
发布/
猫崽角色设计_版权材料/

# ── 视频 / 媒体 ────────────────────────────────
# 演示录屏（82M，体积大；README 不引用它，需要时单独分发）
docs/*.mp4

# ── Agent 工作记忆 ─────────────────────────────
# .workbuddy/ 是开发过程记录，含本机绝对路径（/Users/…），不进仓库
.workbuddy/

# ── 编辑器 / 系统杂项 ────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── 验证工具链的产物 ──
harness/build/         # head.swift + 编译出来的工具 + 隐藏的编译目录
harness/out/           # 对照图（随时可以重出）
